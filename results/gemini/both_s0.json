"version": 1, "source": "def decide_parentheses_square_curly(s):\n    \"\"\"Decide if the parentheses, square and curly brackets in s are balanced.\"\"\"\n    stack = []\n    mapping = {')': '(', '}': '{', ']': '['}\n    for char in s:\n        if char in mapping.values():\n            stack.append(char)\n        elif char in mapping.keys():\n            if not stack or stack[-1] != mapping[char]:\n                return False\n            stack.pop()\n    return len(stack) == 0\n", "docstring": "Decide if the parentheses, square and curly brackets in s are balanced.", "params": ["s"], "origin_episode": "s0-10", "gate": {"cases": 3, "passed": 3, "reason": "passed all replay cases"}, "status": "active", "uses": 2, "successes": 2, "created_at": 36000.0, "last_used": 154800.0}, {"name": "compute_days_separating_two", "version": 1, "source": "from datetime import date\n\ndef compute_days_separating_two(a, b):\n    \"\"\"Compute the number of days separating the two ISO dates a and b.\"\"\"\n    date_a = date.fromisoformat(a)\n    date_b = date.fromisoformat(b)\n    return abs((date_a - date_b).days)\n", "docstring": "Compute the number of days separating the two ISO dates a and b.", "params": ["a", "b"], "origin_episode": "s0-17", "gate": {"cases": 3, "passed": 3, "reason": "passed all replay cases"}, "status": "active", "uses": 3, "successes": 3, "created_at": 61200.0, "last_used": 126000.0}], "events": [{"ts": 32400.0, "type": "created", "name": "seconds_duration", "version": 1}, {"ts": 36000.0, "type": "created", "name": "decide_parentheses_square_curly", "version": 1}, {"ts": 39600.0, "type": "used", "name": "seconds_duration", "version": 1, "success": true}, {"ts": 43200.0, "type": "used", "name": "seconds_duration", "version": 1, "success": true}, {"ts": 50400.0, "type": "used", "name": "seconds_duration", "version": 1, "success": true}, {"ts": 54000.0, "type": "used", "name": "seconds_duration", "version": 1, "success": true}, {"ts": 61200.0, "type": "created", "